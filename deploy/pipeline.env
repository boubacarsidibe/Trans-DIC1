# Valeurs factices, suffisantes pour que « docker compose build » lise docker-compose.prod.yml.
# Aucun secret ici : les vraies valeurs sont dans .env.staging et .env.prod sur les serveurs.
PUBLIC_HOSTNAME=build.invalid
PUBLIC_URL=https://build.invalid
DATABASE_PASSWORD=construction-seulement
JWT_SECRET=construction-seulement-construction-seulement-construction
BACKUP_ENCRYPTION_KEY=construction-seulement
