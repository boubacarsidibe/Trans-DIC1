{
  "id": "cisco-ios",
  "version": 1,
  "name": "Routeur ou commutateur Cisco IOS",
  "vendor": "Cisco",
  "category": "ROUTER",
  "description": "Routeur ou commutateur Cisco IOS / IOS-XE : charge CPU sur 5 minutes (CISCO-PROCESS-MIB) et pool mémoire processeur (CISCO-MEMORY-POOL-MIB). L'index 1 correspond au premier processeur et au pool « Processor » sur la plupart des châssis simples ; à vérifier par snmpwalk sur un châssis modulaire. OID non validés sur matériel de l'EPT.",
  "verified": false,
  "sysDescrHints": ["Cisco IOS", "IOS-XE"],
  "metrics": [
    {
      "name": "Charge CPU (5 min)",
      "technicalKey": "cpu.usage",
      "valueType": "INTEGER",
      "unit": "%",
      "snmpOid": "1.3.6.1.4.1.9.9.109.1.1.1.1.8.1",
      "source": "CISCO-PROCESS-MIB::cpmCPUTotal5minRev.1"
    },
    {
      "name": "Mémoire processeur utilisée",
      "technicalKey": "memory.used",
      "valueType": "DECIMAL",
      "unit": "Mo",
      "snmpOid": "1.3.6.1.4.1.9.9.48.1.1.1.5.1",
      "source": "CISCO-MEMORY-POOL-MIB::ciscoMemoryPoolUsed.1 (octets, converti en Mo)",
      "scale": 0.000001
    },
    {
      "name": "Mémoire processeur libre",
      "technicalKey": "memory.free",
      "valueType": "DECIMAL",
      "unit": "Mo",
      "snmpOid": "1.3.6.1.4.1.9.9.48.1.1.1.6.1",
      "source": "CISCO-MEMORY-POOL-MIB::ciscoMemoryPoolFree.1 (octets, converti en Mo)",
      "scale": 0.000001
    },
    {
      "name": "Durée de fonctionnement",
      "technicalKey": "system.uptime",
      "valueType": "DECIMAL",
      "unit": "s",
      "snmpOid": "1.3.6.1.2.1.1.3.0",
      "source": "SNMPv2-MIB::sysUpTime.0 (centièmes de seconde, converti en secondes)",
      "scale": 0.01
    }
  ],
  "rules": [
    {
      "name": "CPU élevé",
      "metricKey": "cpu.usage",
      "operator": "GREATER_THAN",
      "threshold": 80,
      "recoveryThreshold": 70,
      "unit": "%",
      "confirmationSeconds": 300,
      "severity": "WARNING"
    },
    {
      "name": "Mémoire libre faible",
      "metricKey": "memory.free",
      "operator": "LESS_THAN",
      "threshold": 16,
      "recoveryThreshold": 24,
      "unit": "Mo",
      "confirmationSeconds": 300,
      "severity": "WARNING"
    }
  ],
  "probes": [
    { "name": "Ping", "type": "ICMP", "intervalSeconds": 60 },
    { "name": "SSH", "type": "TCP_PORT", "port": 22, "intervalSeconds": 300 }
  ],
  "eventRules": [
    {
      "name": "Lien tombé (trap linkDown)",
      "description": "Trap standard linkDown (IF-MIB) : une interface est passée hors service.",
      "oidPrefix": "1.3.6.1.6.3.1.1.5.3",
      "severity": "WARNING"
    },
    {
      "name": "Interface en panne (syslog LINK-3-UPDOWN)",
      "description": "Message syslog IOS « %LINK-3-UPDOWN … changed state to down ».",
      "messageRegex": "%LINK-3-UPDOWN.*down",
      "severity": "WARNING"
    }
  ]
}
