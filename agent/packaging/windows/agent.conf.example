# Configuration de l'agent Trans-DIC1 sous Windows : C:\ProgramData\Trans-DIC1-Agent\agent.conf
# Chaque valeur peut être remplacée par une variable TRANS_DIC1_AGENT_<NOM> (ex. TRANS_DIC1_AGENT_INTERVAL).
# Le jeton n'est jamais écrit ici : il est dans token_file, protégé par ACL (SYSTEM, administrateurs
# et compte de l'agent seulement).

[agent]
# Adresse de la plateforme, en HTTPS (le reverse proxy de production).
server_url = https://supervision.example

# Jeton affiché une seule fois à l'enregistrement de l'agent dans la plateforme.
token_file = C:\ProgramData\Trans-DIC1-Agent\token

# Inscription automatique (ADR 0054) : au lieu d'un jeton personnel, un jeton d'inscription partagé
# par tout un parc (préfixe tdic1e_). Au premier démarrage, l'agent s'inscrit, écrit le jeton reçu
# dans token_file et supprime ce fichier. install.ps1 -EnrollTokenFile règle ces deux lignes.
# token_file = C:\ProgramData\Trans-DIC1-Agent\state\token
# enroll_token_file = C:\ProgramData\Trans-DIC1-Agent\state\enroll-token

# Secondes entre deux relevés (10 à 240 ; la plateforme signale un agent muet après 300 s).
interval = 60

# Lecteur mesuré pour disk.usage (défaut : le lecteur système, souvent C:\).
# disk_path = D:\

# Journal de l'agent (rotation à 1 Mo, 3 sauvegardes). Windows n'a pas de journald : l'agent écrit le sien.
log_file = C:\ProgramData\Trans-DIC1-Agent\logs\agent.log

# Délai d'une requête (s), réessais après une erreur temporaire, attente initiale entre réessais (s).
timeout = 10
max_retries = 3
backoff = 2

# Mesures gardées en mémoire pendant une panne de la plateforme (les plus anciennes partent d'abord).
buffer_limit = 2000

# Autorité de certification interne, si le certificat de la plateforme n'est pas public.
# ca_file = C:\ProgramData\Trans-DIC1-Agent\autorite-interne.pem

# Services surveillés, séparés par des virgules (état remonté dans service.up[nom]).
# services = Spooler, W32Time

# --- Actions correctives (ADR 0050 et 0057) ----------------------------------
# La plateforme ne transmet qu'un NOM d'action ; la commande correspondante est écrite ici, sur
# cette machine, et nulle part ailleurs. Un nom absent de cette liste est refusé.
# Commande lancée sans interpréteur par l'agent (cmd.exe n'est jamais appelé), durée bornée par
# action_timeout. Quand une action appelle elle-même PowerShell, c'est avec une commande FIXE
# écrite ici : la plateforme n'y ajoute rien.
#
# CATALOGUE PRÊT À L'EMPLOI, DÉSACTIVÉ PAR DÉFAUT : décommenter les lignes voulues.
#
# Droits à accorder au compte de l'agent (LOCAL SERVICE, SID S-1-5-19), en administrateur :
#  - démarrer ou redémarrer un service : ajouter à son descripteur l'entrée (A;;RPWPLC;;;LS).
#    Lire d'abord le descripteur actuel, puis le réécrire avec l'entrée ajoutée avant « S: » :
#      sc.exe sdshow Spooler
#      sc.exe sdset Spooler "D:(A;;CCLCSWLOCRRC;;;AU)...(A;;RPWPLC;;;LS)S:..."
#  - nettoyer un dossier : droit de modification sur ce dossier seulement :
#      icacls "C:\Appli\temp" /grant "*S-1-5-19:(OI)(CI)M"
#
# [actions]
# demarrer-spouleur = "C:\Windows\System32\sc.exe" start Spooler
# redemarrer-spouleur = "C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -Command "Restart-Service -Name Spooler -Force"
# redemarrer-iis = "C:\Windows\System32\iisreset.exe" /restart
# nettoyer-temp-appli = "C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -Command "Get-ChildItem -LiteralPath 'C:\Appli\temp' -File | Where-Object LastWriteTime -lt (Get-Date).AddDays(-7) | Remove-Item -Force"
#
# [action_descriptions]
# demarrer-spouleur = Démarre le spouleur d'impression arrêté
# redemarrer-spouleur = Redémarre le spouleur d'impression
# redemarrer-iis = Redémarre IIS (le compte de l'agent doit être administrateur local : à éviter)
# nettoyer-temp-appli = Supprime les fichiers de plus de 7 jours de C:\Appli\temp
