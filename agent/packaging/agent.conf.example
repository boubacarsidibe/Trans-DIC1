# Configuration de l'agent Trans-DIC1 : /etc/trans-dic1-agent/agent.conf
# Chaque valeur peut être remplacée par une variable TRANS_DIC1_AGENT_<NOM> (ex. TRANS_DIC1_AGENT_INTERVAL).
# Le jeton n'est jamais écrit ici : il est dans token_file (droits 600).

[agent]
# Adresse de la plateforme, en HTTPS (le reverse proxy de production).
server_url = https://supervision.example

# Jeton affiché une seule fois à l'enregistrement de l'agent dans la plateforme.
token_file = /etc/trans-dic1-agent/token

# Inscription automatique (ADR 0054) : au lieu d'un jeton personnel, un jeton d'inscription partagé
# par tout un parc (préfixe tdic1e_). Au premier démarrage, l'agent s'inscrit, écrit le jeton reçu
# dans token_file et supprime ce fichier. install.sh --enroll-token-file règle ces deux lignes.
# token_file = /var/lib/trans-dic1-agent/token
# enroll_token_file = /var/lib/trans-dic1-agent/enroll-token

# Secondes entre deux relevés (10 à 240 ; la plateforme signale un agent muet après 300 s).
interval = 60

# Système de fichiers mesuré pour disk.usage.
disk_path = /

# Délai d'une requête (s), réessais après une erreur temporaire, attente initiale entre réessais (s).
timeout = 10
max_retries = 3
backoff = 2

# Mesures gardées en mémoire pendant une panne de la plateforme (les plus anciennes partent d'abord).
buffer_limit = 2000

# Autorité de certification interne, si le certificat de la plateforme n'est pas public.
# ca_file = /etc/ssl/certs/autorite-interne.pem

# Services surveillés, séparés par des virgules (état remonté dans service.up[nom]).
# services = nginx, ssh

# --- Journaux de sécurité ---------------------------------------------------
# L'agent lit et découpe les lignes, le serveur juge s'il s'agit d'une attaque.
# Il part de la fin des fichiers au démarrage : rien d'ancien n'est renvoye.

# Journaux d'authentification. Par défaut, ceux du système qui existent
# (/var/log/auth.log, /var/log/secure). Mettre une liste vide pour ne rien lire.
# auth_logs = /var/log/auth.log

# Journaux d'accès web au format courant (nginx, Apache), séparés par des virgules.
# Rien par défaut : le chemin dépend du site servi. Un format personnalisé n'est pas lu.
# access_logs = /var/log/nginx/access.log

# --- Actions correctives (ADR 0050 et 0057) ----------------------------------
# La plateforme ne transmet qu'un NOM d'action ; la commande correspondante est écrite ici, sur
# cette machine, et nulle part ailleurs. Un nom absent de cette liste est refusé (code 127).
# Commande lancée sans interpréteur de commandes (pas de « ; », « | », « $( ) »), entrée fermée,
# durée bornée par action_timeout (section [agent], 1 à 600 s, 60 par défaut).
#
# CATALOGUE PRÊT À L'EMPLOI, DÉSACTIVÉ PAR DÉFAUT : décommenter les lignes voulues dans [actions]
# et [action_descriptions] (les deux sections ne doivent apparaître qu'une fois dans le fichier).
#
# Privilèges : l'agent tourne sous son propre compte, sans droit. Une commande qui en a besoin passe
# par sudo, avec une règle limitée à cette commande exacte, dans /etc/sudoers.d/trans-dic1-agent
# (droits 440, à vérifier avec « visudo -cf /etc/sudoers.d/trans-dic1-agent ») :
#
#   trans-dic1-agent ALL=(root) NOPASSWD: /usr/bin/systemctl restart nginx
#   trans-dic1-agent ALL=(root) NOPASSWD: /usr/bin/systemctl restart apache2
#   trans-dic1-agent ALL=(root) NOPASSWD: /usr/bin/systemctl restart php8.2-fpm
#   trans-dic1-agent ALL=(root) NOPASSWD: /usr/bin/systemctl reload php8.2-fpm
#   trans-dic1-agent ALL=(root) NOPASSWD: /usr/bin/find /var/cache/nginx -mindepth 1 -delete
#   trans-dic1-agent ALL=(root) NOPASSWD: /usr/sbin/logrotate --force /etc/logrotate.conf
#   trans-dic1-agent ALL=(root) NOPASSWD: /usr/bin/find /var/tmp/appli -type f -mtime +7 -delete
#
# ET le service systemd doit autoriser sudo, que son durcissement interdit par défaut
# (NoNewPrivileges, ProtectSystem=strict) : installer le complément fourni
#   sudo install -D -m 644 actions-privileges.conf /etc/systemd/system/trans-dic1-agent.service.d/actions.conf
#   sudo systemctl daemon-reload && sudo systemctl restart trans-dic1-agent
# Sans actions, ne pas l'installer : l'agent garde son durcissement complet.
# Le rôle Ansible (deploy/ansible, variable trans_dic1_agent_actions) fait ces trois gestes.
#
# [actions]
# redemarrer-nginx = sudo -n /usr/bin/systemctl restart nginx
# redemarrer-apache2 = sudo -n /usr/bin/systemctl restart apache2
# redemarrer-php-fpm = sudo -n /usr/bin/systemctl restart php8.2-fpm
# vider-cache-opcache = sudo -n /usr/bin/systemctl reload php8.2-fpm
# vider-cache-nginx = sudo -n /usr/bin/find /var/cache/nginx -mindepth 1 -delete
# rotation-journaux = sudo -n /usr/sbin/logrotate --force /etc/logrotate.conf
# nettoyer-tmp-appli = sudo -n /usr/bin/find /var/tmp/appli -type f -mtime +7 -delete
#
# [action_descriptions]
# redemarrer-nginx = Redémarre le serveur web nginx
# redemarrer-apache2 = Redémarre le serveur web Apache
# redemarrer-php-fpm = Redémarre PHP-FPM
# vider-cache-opcache = Recharge PHP-FPM, ce qui vide le cache d'opcodes
# vider-cache-nginx = Vide le cache de nginx (/var/cache/nginx)
# rotation-journaux = Force la rotation des journaux (logrotate)
# nettoyer-tmp-appli = Supprime les fichiers de plus de 7 jours de /var/tmp/appli
