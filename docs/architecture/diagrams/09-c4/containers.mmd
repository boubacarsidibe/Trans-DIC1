C4Container
    title Conteneurs de Trans-DIC1 (docker-compose.prod.yml)

    Person(user, "Utilisateur EPT", "Administrateur, opérateur NOC ou lecteur")
    System_Ext(devices, "Équipements réseau", "SNMP v2c/v3")
    System_Ext(agent, "Agent Trans-DIC1", "Python 3, service systemd sur chaque serveur supervisé")
    System_Ext(smtp, "SMTP, Teams, Slack, webhooks", "Canaux de notification")

    System_Boundary(transdic, "Trans-DIC1") {
        Container(proxy, "Reverse proxy", "Nginx sans privilèges", "Seul point d'entrée : TLS, HSTS, redirection HTTP, routage")
        Container(web, "Application web", "React 19, Vite 8, servie par Nginx", "Tableau de bord, inventaire, alertes, rapports, administration")
        Container(api, "API et collecte", "Java 21, Spring Boot 4.1", "REST /api/v1, SSE, contrôle d'accès, collecte SNMP et réception des agents, alertes, notifications, audit")
        ContainerDb(db, "Base de données", "PostgreSQL 16", "Inventaire, métriques partitionnées, alertes, file de notifications, audit, état des tâches")
        Container(backup, "Sauvegarde", "postgres:16-alpine, openssl", "Dump chiffré quotidien, rétention, restauration de contrôle")
        Container(obs, "Supervision de la plateforme", "Prometheus, Alertmanager, Grafana, Jaeger", "Métriques, alertes techniques, traces (profil observability)")
    }

    Rel(user, proxy, "Utilise", "HTTPS")
    Rel(agent, proxy, "Envoie ses mesures", "HTTPS, jeton d'agent")
    Rel(proxy, web, "Sert l'interface", "HTTP interne")
    Rel(proxy, api, "Transmet /api", "HTTP interne, SSE")
    Rel(web, api, "Appelle", "REST JSON, SSE, même origine")
    Rel(api, db, "Lit et écrit", "JDBC, JPA, Flyway")
    Rel(api, devices, "Interroge et découvre", "SNMP")
    Rel(api, smtp, "Envoie les notifications", "SMTP, HTTPS")
    Rel(backup, db, "Sauvegarde et restaure", "pg_dump, pg_restore")
    Rel(obs, api, "Collecte les métriques, reçoit les traces", "HTTP, jeton de collecte, OTLP")
