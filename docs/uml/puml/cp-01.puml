interface "API /api/v1/auth" as IA
interface "API /api/v1/equipements" as IE
interface "API /api/v1/metrics" as IM
component "Module security" as MS
component "Module inventory" as MI
component "Module monitoring" as MM
database "PostgreSQL 16\ntrans_dic1" as PG
component "Flyway (V1..V4)" as FW
SPA ..> IA : use
SPA ..> IE : use
SPA ..> IM : use
MS ..|> IA
MI ..|> IE
