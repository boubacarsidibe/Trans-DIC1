@startuml
title CD-01 Modèle du domaine (entités et énumérations)
skinparam classAttributeIconSize 0
left to right direction
class Site <<Entity>> {
  -id : UUID
  -code : String
  -name : String
  -status : String
  -createdAt : Instant
  +getId() : UUID
  +getName() : String
}
class Equipment <<Entity>> {
  -id : UUID
  -inventoryCode : String
  -name : String
  -managementAddress : String
  -type : EquipmentType
  -status : EquipmentStatus
  -fictitious : boolean
  -createdAt : Instant
  +update(name : String, address : String, type : EquipmentType, status : EquipmentStatus, site : Site)
  +getId() : UUID
  +getInventoryCode() : String
  +getName() : String
  +getManagementAddress() : String
  +getType() : EquipmentType
  +getStatus() : EquipmentStatus
  +getSite() : Site
}
enum EquipmentType {
  SERVER
  ROUTER
  SWITCH
  VIRTUAL_MACHINE
  WIFI_ACCESS_POINT
}
enum EquipmentStatus {
  UP
  DOWN
  DEGRADED
  MAINTENANCE
  UNKNOWN
}
class Metric <<Entity>> {
  -id : UUID
  -equipment : Equipment
  -key : String
  -value : BigDecimal
  -unit : String
  -quality : String
  -collectedAt : Instant
  -receivedAt : Instant
  +getId() : UUID
  +getEquipment() : Equipment
  +getKey() : String
  +getValue() : BigDecimal
  +getUnit() : String
  +getQuality() : String
  +getCollectedAt() : Instant
}
class AppUser <<Entity>> {
  -id : UUID
  -username : String
  -email : String
  -passwordHash : String
  -role : Role
  -active : boolean
  -createdAt : Instant
  +getUsername() : String
  +getPasswordHash() : String
  +getRole() : Role
  +isActive() : boolean
}
enum Role {
  ADMIN
  NOC_OPERATOR
  VIEWER
}
Equipment "0..*" --> "1" Site : est situé sur
Equipment "0..*" --> "1" EquipmentType : type
Equipment "0..*" --> "1" EquipmentStatus : statut
Metric "0..*" --> "1" Equipment : mesure
AppUser "0..*" --> "1" Role : rôle
@enduml
