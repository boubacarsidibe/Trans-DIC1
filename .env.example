# Copiez ce fichier vers .env pour un environnement local.
# Ne renseignez jamais de secret réel dans ce modèle versionné.

APP_ENV=development
APP_HOST=localhost
APP_PORT=8080
# native derrière le reverse proxy de production (adresse du client lue dans X-Forwarded-For).
FORWARD_HEADERS_STRATEGY=none

# Production (docker-compose.prod.yml, docs/devops/deployment.md) : à renseigner dans .env.prod.
PUBLIC_HOSTNAME=
TLS_CERT_DIR=./proxy/tls
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_REGISTRY=trans-dic1
IMAGE_TAG=local

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trans_dic1
DATABASE_USER=trans_dic1
DATABASE_PASSWORD=

VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_AUTH_REQUIRED=false

JWT_SECRET=
JWT_EXPIRATION_SECONDS=900
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Cookie de renouvellement (ADR-0005) : mettre false seulement pour un developpement en HTTP hors localhost.
REFRESH_COOKIE_SECURE=true
REFRESH_MAX_AGE_SECONDS=28800
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SNMP_COMMUNITY=
SNMPV3_USERNAME=
SNMPV3_AUTH_PASSWORD=
SNMPV3_PRIV_PASSWORD=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM=trans-dic1@ept.sn
# Canaux externes : on ne met ici que les URL (jamais dans la base). Les préférences y renvoient par env:NOM.
# NOTIFICATION_WEBHOOK_SECRET=secret-de-signature-des-webhooks
# TEAMS_NOC_URL=https://...
# SLACK_NOC_URL=https://...
PUBLIC_URL=http://localhost:5173

# Sauvegarde PostgreSQL (OPS-02) : clé de chiffrement de 32 caractères minimum, à conserver
# hors du serveur (sans elle, aucune sauvegarde n'est restaurable).
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_RESTORE_CHECK=true
RTO_SECONDS=14400
# Dossier hôte des sauvegardes (stockage distinct du serveur) ; vide = volume Docker backup-data.
BACKUP_HOST_DIR=

# Observabilité (ARCH-08, docs/devops/observability.md).
# Jeton de Prometheus pour /actuator/prometheus (32 caractères minimum ; vide = endpoint fermé).
METRICS_SCRAPE_TOKEN=
# Export des traces OpenTelemetry (OTLP HTTP) ; Jaeger dans le profil Compose observability.
TRACING_EXPORT_ENABLED=false
TRACING_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1
# Mot de passe du compte admin de Grafana (vide = admin, changement imposé à la première connexion).
GRAFANA_ADMIN_PASSWORD=

WEBHOOK_URL=
